{
  "name": "sight-language-server",
  "version": "0.8.4",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "description": "Language Server Protocol implementation for Stata",
  "main": "dist/sight-server.js",
  "bin": {
    "sight": "dist/sight-server.js",
    "sight-language-server": "dist/sight-server.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/command-database/caches dist/command-database/ && bun run build:bundle && cd client && npm run compile && npm run copy-server && cd ..",
    "build:bundle": "bun scripts/build-binary.ts bundle",
    "build:binary": "bun scripts/build-binary.ts binary",
    "build:current": "bun scripts/build-binary.ts current",
    "build:all": "bun scripts/build-binary.ts all",
    "build:npm": "bun run build:bundle && npm run validate:npm",
    "validate:npm": "node dist/sight-server.js --version && echo 'NPM build validation passed'",
    "prepublishOnly": "npm run build:npm",
    "publish:npm": "npm publish",
    "publish:dry-run": "npm publish --dry-run",
    "install:binary": "bun scripts/install.ts",
    "uninstall:binary": "bun scripts/uninstall.ts",
    "watch": "tsc --watch",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:tests:scope-resolver": "tsc -p tsconfig.scope-resolver-tests.json",
    "typecheck": "tsc --noEmit && bun run typecheck:scripts && bun run typecheck:tests:scope-resolver && cd client && tsc --noEmit",
    "test": "bun run typecheck; bun test ./tests",
    "test:watch": "bun test --watch ./tests",
    "lint": "eslint src client/src",
    "clean": "rm -rf dist bin",
    "package": "bun run build && cd client && bun run copy-server && bun run package",
    "version:patch": "bun scripts/bump-version.ts patch",
    "version:minor": "bun scripts/bump-version.ts minor",
    "version:major": "bun scripts/bump-version.ts major",
    "release": "bun scripts/release.ts"
  },
  "keywords": [
    "stata",
    "lsp",
    "language-server",
    "language-server-protocol",
    "ide",
    "editor",
    "autocomplete",
    "syntax-highlighting",
    "go-to-definition",
    "diagnostics",
    "typescript"
  ],
  "author": "Jonathan Marc Bearak",
  "license": "GPL-3.0",
  "dependencies": {
    "@jbearak/dta-parser": "^0.2.0",
    "smol-toml": "^1.6.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@types/jest": "^29.5.8",
    "@types/node": "^24.0.0",
    "bun-types": "^1.3.5",
    "esbuild": "^0.27.2",
    "eslint": "^9.18.0",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.20.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.0.0"
  }
}
