{
  "name": "sight",
  "displayName": "Sight - Stata Language Server",
  "description": "Stata language support: language server, syntax highlighting, and code execution",
  "version": "0.12.0",
  "publisher": "jbearak",
  "icon": "icon.png",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbearak/sight"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "stata",
        "aliases": [
          "Stata",
          "stata"
        ],
        "extensions": [
          ".do",
          ".ado",
          ".mata"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "stata",
        "scopeName": "source.stata",
        "path": "./syntaxes/stata.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "sight.dataBrowserEditor",
        "displayName": "Sight Data Browser",
        "selector": [
          {
            "filenamePattern": "*.dta"
          },
          {
            "filenamePattern": "*.DTA"
          }
        ],
        "priority": "default"
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "sight.stataTerminal",
          "title": "Stata",
          "icon": "terminal"
        }
      ]
    },
    "configuration": {
      "title": "Sight Language Server",
      "properties": {
        "sight.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable all diagnostics"
        },
        "sight.diagnostics.severity.undefinedMacro": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint",
            "off"
          ],
          "default": "warning",
          "description": "Severity level for undefined macro references",
          "enumDescriptions": [
            "Show as error",
            "Show as warning",
            "Show as information",
            "Show as hint",
            "Disable this diagnostic"
          ]
        },
        "sight.diagnostics.severity.undefinedVariable": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint",
            "off"
          ],
          "default": "off",
          "description": "[Experimental] Severity level for undefined variable references. Off by default since the LSP cannot statically determine which variables exist in your dataset. Use the sight: variables directive to declare variables loaded from data files (@lsp-variables remains an alias).",
          "enumDescriptions": [
            "Show as error",
            "Show as warning",
            "Show as information",
            "Show as hint",
            "Disable this diagnostic (default)"
          ]
        },
        "sight.diagnostics.severity.styleWarnings": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint",
            "off"
          ],
          "default": "hint",
          "description": "Severity level for style warnings",
          "enumDescriptions": [
            "Show as error",
            "Show as warning",
            "Show as information",
            "Show as hint",
            "Disable this diagnostic"
          ]
        },
        "sight.diagnostics.severity.malformedOperator": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint",
            "off"
          ],
          "default": "warning",
          "description": "Severity level for malformed operator diagnostics (e.g., '= =' instead of '=='). Set to 'off' to disable.",
          "enumDescriptions": [
            "Show as error",
            "Show as warning",
            "Show as information",
            "Show as hint",
            "Disable this diagnostic"
          ]
        },
        "sight.diagnostics.severity.spacedCompoundOperator": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint",
            "off"
          ],
          "default": "information",
          "description": "Severity level for spaced compound operator diagnostics that Stata accepts (e.g., '< =' instead of '<='). Set to 'off' to disable.",
          "enumDescriptions": [
            "Show as error",
            "Show as warning",
            "Show as information",
            "Show as hint",
            "Disable this diagnostic"
          ]
        },
        "sight.diagnostics.severity.invalidOperatorSequence": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint",
            "off"
          ],
          "default": "error",
          "description": "Severity level for invalid operator sequence diagnostics (e.g., '< |'). Set to 'off' to disable.",
          "enumDescriptions": [
            "Show as error",
            "Show as warning",
            "Show as information",
            "Show as hint",
            "Disable this diagnostic"
          ]
        },
        "sight.diagnostics.severity.cStyleLogicalInControlFlow": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint",
            "off"
          ],
          "default": "information",
          "description": "Severity level for C-style logical operators (&&, ||) in if/else if control flow statements. These operators work in control flow but are stylistically discouraged. Set to 'off' to disable.",
          "enumDescriptions": [
            "Show as error",
            "Show as warning",
            "Show as information",
            "Show as hint",
            "Disable this diagnostic"
          ]
        },
        "sight.diagnostics.severity.mixedLogicalOperators": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint",
            "off"
          ],
          "default": "warning",
          "description": "Severity level for mixed '&' and '|' operators without parentheses. Parentheses clarify precedence and prevent subtle logic bugs. Set to 'off' to disable.",
          "enumDescriptions": [
            "Show as error",
            "Show as warning",
            "Show as information",
            "Show as hint",
            "Disable this diagnostic"
          ]
        },
        "sight.diagnostics.severity.chainedComparison": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint",
            "off"
          ],
          "default": "warning",
          "description": "Severity level for suspicious chained comparisons (e.g., 'a != b != c'). Stata evaluates comparisons left-to-right rather than as a mathematical chain, so this is often a missing logical operator or parentheses. Set to 'off' to disable.",
          "enumDescriptions": [
            "Show as error",
            "Show as warning",
            "Show as information",
            "Show as hint",
            "Disable this diagnostic"
          ]
        },
        "sight.diagnostics.severity.literalMacroAdjacency": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint",
            "off"
          ],
          "default": "hint",
          "description": "Severity level for a literal placed directly against a macro reference in an expression (e.g., 'a == 1`b''). Stata concatenates these during macro expansion, which is often unintended. Set to 'off' to disable.",
          "enumDescriptions": [
            "Show as error",
            "Show as warning",
            "Show as information",
            "Show as hint",
            "Disable this diagnostic"
          ]
        },
        "sight.diagnostics.indentation": {
          "type": "boolean",
          "default": false,
          "description": "Enable indentation diagnostics (missing/unnecessary indentation warnings). Disabled by default since indentation is stylistic in Stata and doesn't affect execution."
        },
        "sight.lineCommentStyle": {
          "type": "string",
          "enum": [
            "//",
            "*"
          ],
          "default": "//",
          "description": "Line comment character used by the toggle comment shortcut. In Stata, '//' can appear anywhere on a line while '*' must be at the start of a line.",
          "enumDescriptions": [
            "Use // for line comments (works anywhere on a line)",
            "Use * for line comments (must be at the start of a line)"
          ]
        },
        "sight.formatting.indentSize": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "description": "Number of spaces or tab stops for indentation"
        },
        "sight.formatting.indentStyle": {
          "type": "string",
          "enum": [
            "spaces",
            "tabs"
          ],
          "default": "spaces",
          "description": "Use spaces or tabs for indentation",
          "enumDescriptions": [
            "Use spaces for indentation",
            "Use tabs for indentation"
          ]
        },
        "sight.formatting.lineWidth": {
          "type": "number",
          "default": 80,
          "minimum": 40,
          "description": "Maximum line width for formatting"
        },
        "sight.formatting.preferredCommentStyle": {
          "type": "string",
          "enum": [
            "line",
            "//",
            "*",
            "/* */"
          ],
          "default": "line",
          "description": "Preferred comment style for normalization. 'line' uses the value of sight.lineCommentStyle.",
          "enumDescriptions": [
            "Use the same style as sight.lineCommentStyle",
            "Use // for line comments",
            "Use * for line comments",
            "Use /* */ for block comments"
          ]
        },
        "sight.formatting.normalizeCommentStyle": {
          "type": "boolean",
          "default": false,
          "description": "Normalize comment styles during formatting"
        },
        "sight.formatting.commentLineWidth": {
          "type": "number",
          "default": 72,
          "minimum": 40,
          "description": "Maximum line width for comments"
        },
        "sight.formatting.mode": {
          "type": "string",
          "enum": [
            "source-preserving",
            "ast"
          ],
          "default": "source-preserving",
          "description": "Formatter mode. 'source-preserving' (default) safely adjusts indentation. 'ast' (experimental) uses AST-based formatting - useful for testing but may produce unexpected output.",
          "enumDescriptions": [
            "Safe mode that preserves source structure and only adjusts indentation",
            "Experimental mode that reconstructs code from AST - useful for testing parser correctness"
          ]
        },
        "sight.indexing.maxFileSizeBytes": {
          "type": "number",
          "default": 500000,
          "description": "Maximum file size in bytes for indexing (default ~500KB)"
        },
        "sight.indexWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Enable workspace-wide symbol indexing"
        },
        "sight.adoPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional paths to search for ADO files"
        },
        "sight.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Workspace-relative glob patterns to exclude from `sight check` and workspace indexing (e.g. [\"output/**\"]). Files opened directly in the editor are still analyzed."
        },
        "sight.sendToStata.stataApp": {
          "type": "string",
          "default": "",
          "description": "Override Stata application name (macOS only). Case-sensitive: enter the name exactly. Leave empty for auto-detection, which scans /Applications/Stata and /Applications/StataNow. Options: StataMP, StataSE, StataBE, StataIC, Stata"
        },
        "sight.sendToStata.focusStataWindow": {
          "type": "boolean",
          "default": false,
          "description": "Switch focus to Stata after sending code. When false (default), focus stays in the editor."
        },
        "sight.sendToStata.saveBeforeSend": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save the file before sending to Stata"
        },
        "sight.sendToStata.advanceCursorOnSend": {
          "type": "boolean",
          "default": true,
          "description": "Automatically advance cursor to the next line after sending a single line to Stata"
        },
        "sight.sendToStata.target": {
          "type": "string",
          "enum": [
            "auto",
            "integrated",
            "external"
          ],
          "default": "auto",
          "description": "Where to send Stata commands",
          "enumDescriptions": [
            "Auto: use the Stata GUI when running locally (macOS/Windows), use the integrated Stata terminal in remote sessions (SSH, WSL, Dev Container, Tunnel) and on Linux",
            "Always use the integrated VS Code Stata terminal. Not available on native Windows (Stata has no interactive CLI); falls back to the GUI with a warning.",
            "Always use the external Stata GUI application (macOS and Windows only; not available in remote sessions or on Linux)"
          ]
        },
        "sight.sendToStata.workingDirectory": {
          "type": "string",
          "enum": [
            "lsp",
            "none",
            "file",
            "workspace"
          ],
          "default": "lsp",
          "description": "Set working directory before executing code",
          "enumDescriptions": [
            "Use working directory from LSP (from sight: cd, sight: working-directory, sight: wd directives or inherited from parent files; @lsp- remains an alias)",
            "Do not change working directory",
            "Change to the directory of the current file",
            "Change to the workspace root directory"
          ]
        },
        "sight.personalAdoDir": {
          "type": "string",
          "default": "",
          "description": "Path where Sight installs its Stata commands. Leave empty for the platform default (macOS: ~/ado/, Linux: ~/ado/personal/, Windows: %USERPROFILE%\\ado\\personal\\)."
        },
        "sight.dataBrowser.maxStoredLayouts": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "description": "Maximum number of dataset layout entries (column widths and visibility) stored across all datasets. When the limit is reached, the least recently used entries are removed first. Each dataset may use multiple entries for alias keys."
        },
        "sight.dataBrowser.persistSort": {
          "type": "boolean",
          "default": true,
          "description": "Remember the row sort applied to a dataset and restore it the next time the same dataset (matching shape) is opened."
        },
        "sight.dataBrowser.persistFilters": {
          "type": "boolean",
          "default": true,
          "description": "Remember the row filters applied to a dataset and restore them the next time the same dataset (matching shape) is opened. The surviving rows are always recomputed against the current data."
        },
        "sight.dataBrowser.missingValueStyle": {
          "type": "string",
          "enum": [
            "foreground",
            "background",
            "none"
          ],
          "default": "foreground",
          "description": "How to highlight missing values (., .a–.z) in the data browser",
          "enumDescriptions": [
            "Colorize the text (like Stata's default)",
            "Tint the cell background",
            "No special highlighting"
          ]
        },
        "sight.depthColors.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Color nested compound strings and local macros by depth. When disabled, removes Sight's depth color rules from editor.tokenColorCustomizations so your theme's default string and variable colors apply."
        }
      }
    },
    "commands": [
      {
        "command": "sight.openSmclPreview",
        "title": "Open SMCL Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "sight.openSmclPreviewFull",
        "title": "Open SMCL Preview (Full Width)"
      },
      {
        "command": "sight.openHelpTopic",
        "title": "Sight: Open Help Topic"
      },
      {
        "command": "sight.resetDepthColors",
        "title": "Sight: Reset Depth Colors Configuration"
      },
      {
        "command": "sight.resetConflictDismissal",
        "title": "Sight: Reset Conflict Dismissal"
      },
      {
        "command": "sight.doLineOrSelection",
        "title": "Sight: Do Line or Selection"
      },
      {
        "command": "sight.doUpwardLines",
        "title": "Sight: Do Upward Lines"
      },
      {
        "command": "sight.doDownwardLines",
        "title": "Sight: Do Downward Lines"
      },
      {
        "command": "sight.doFile",
        "title": "Sight: Do File"
      },
      {
        "command": "sight.includeLineOrSelection",
        "title": "Sight: Include Line or Selection"
      },
      {
        "command": "sight.includeFile",
        "title": "Sight: Include File"
      },
      {
        "command": "sight.terminal.doLineOrSelection",
        "title": "Sight: Terminal - Do Line or Selection"
      },
      {
        "command": "sight.terminal.doUpwardLines",
        "title": "Sight: Terminal - Do Upward Lines"
      },
      {
        "command": "sight.terminal.doDownwardLines",
        "title": "Sight: Terminal - Do Downward Lines"
      },
      {
        "command": "sight.terminal.doFile",
        "title": "Sight: Terminal - Do File"
      },
      {
        "command": "sight.terminal.includeLineOrSelection",
        "title": "Sight: Terminal - Include Line or Selection"
      },
      {
        "command": "sight.terminal.includeFile",
        "title": "Sight: Terminal - Include File"
      },
      {
        "command": "sight.cdWorkspace",
        "title": "Sight: CD into Workspace Folder"
      },
      {
        "command": "sight.cdFile",
        "title": "Sight: CD into File Folder"
      },
      {
        "command": "sight.terminal.cdWorkspace",
        "title": "Sight: Terminal - CD into Workspace Folder"
      },
      {
        "command": "sight.terminal.cdFile",
        "title": "Sight: Terminal - CD into File Folder"
      },
      {
        "command": "sight.openInStata",
        "title": "Open in Stata",
        "icon": "$(file-text)"
      },
      {
        "command": "sight.openDataBrowser",
        "title": "Sight: Open Data Browser",
        "icon": "$(table)"
      },
      {
        "command": "sight.installVviewAdo",
        "title": "Sight: Install Stata Commands"
      },
      {
        "command": "sight.resetVviewInstallPermission",
        "title": "Sight: Reset Stata Commands Install Permission"
      },
      {
        "command": "sight.uninstallStataCommands",
        "title": "Sight: Uninstall Stata Commands"
      }
    ],
    "keybindings": [
      {
        "command": "sight.doLineOrSelection",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == stata"
      },
      {
        "command": "sight.doFile",
        "key": "shift+ctrl+enter",
        "mac": "shift+cmd+enter",
        "when": "editorTextFocus && editorLangId == stata"
      },
      {
        "command": "sight.includeLineOrSelection",
        "key": "alt+ctrl+enter",
        "mac": "alt+cmd+enter",
        "when": "editorTextFocus && editorLangId == stata"
      },
      {
        "command": "sight.includeFile",
        "key": "alt+shift+ctrl+enter",
        "mac": "alt+shift+cmd+enter",
        "when": "editorTextFocus && editorLangId == stata"
      },
      {
        "command": "sight.terminal.doLineOrSelection",
        "key": "alt+enter",
        "when": "editorTextFocus && editorLangId == stata"
      },
      {
        "command": "sight.terminal.doFile",
        "key": "alt+shift+enter",
        "when": "editorTextFocus && editorLangId == stata"
      },
      {
        "command": "sight.openSmclPreviewFull",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && resourceExtname =~ /\\.(smcl|sthlp)/i"
      },
      {
        "command": "sight.openSmclPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && resourceExtname =~ /\\.(smcl|sthlp)/i"
      }
    ],
    "submenus": [
      {
        "id": "sight.sendToStata",
        "label": "Send to Stata",
        "icon": "$(play)"
      },
      {
        "id": "sight.sendToStata.terminal",
        "label": "Terminal"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sight.openInStata",
          "when": "false"
        },
        {
          "command": "sight.openSmclPreview",
          "when": "resourceExtname =~ /\\.(smcl|sthlp)/i"
        },
        {
          "command": "sight.openSmclPreviewFull",
          "when": "resourceExtname =~ /\\.(smcl|sthlp)/i"
        },
        {
          "command": "sight.openDataBrowser"
        },
        {
          "command": "sight.installVviewAdo"
        },
        {
          "command": "sight.resetVviewInstallPermission"
        },
        {
          "command": "sight.uninstallStataCommands"
        }
      ],
      "explorer/context": [
        {
          "command": "sight.openInStata",
          "when": "(isMac || isWindows) && resourceExtname =~ /\\.(smcl|sthlp)/i",
          "group": "sight@1"
        },
        {
          "command": "sight.openSmclPreview",
          "when": "resourceExtname =~ /\\.(smcl|sthlp)/i",
          "group": "sight@2"
        },
        {
          "command": "sight.openDataBrowser",
          "when": "resourceExtname =~ /\\.dta/i",
          "group": "sight@3"
        }
      ],
      "editor/title": [
        {
          "command": "sight.openSmclPreview",
          "when": "resourceExtname =~ /\\.(smcl|sthlp)/i",
          "group": "navigation"
        },
        {
          "command": "sight.openDataBrowser",
          "when": "resourceExtname =~ /\\.dta/i && activeCustomEditorId != sight.dataBrowserEditor",
          "group": "navigation"
        },
        {
          "submenu": "sight.sendToStata",
          "when": "editorLangId == stata",
          "group": "navigation"
        }
      ],
      "sight.sendToStata": [
        {
          "command": "sight.doLineOrSelection",
          "group": "1_do@1",
          "when": "isMac || isWindows"
        },
        {
          "command": "sight.doUpwardLines",
          "group": "1_do@2",
          "when": "isMac || isWindows"
        },
        {
          "command": "sight.doDownwardLines",
          "group": "1_do@3",
          "when": "isMac || isWindows"
        },
        {
          "command": "sight.doFile",
          "group": "1_do@4",
          "when": "isMac || isWindows"
        },
        {
          "command": "sight.includeLineOrSelection",
          "group": "2_include@1",
          "when": "isMac || isWindows"
        },
        {
          "command": "sight.includeFile",
          "group": "2_include@2",
          "when": "isMac || isWindows"
        },
        {
          "command": "sight.cdWorkspace",
          "group": "3_cd@1",
          "when": "sight.cdMenuVisible && (isMac || isWindows)"
        },
        {
          "command": "sight.cdFile",
          "group": "3_cd@2",
          "when": "sight.cdMenuVisible && (isMac || isWindows)"
        },
        {
          "submenu": "sight.sendToStata.terminal",
          "group": "4_terminal"
        }
      ],
      "sight.sendToStata.terminal": [
        {
          "command": "sight.terminal.doLineOrSelection",
          "group": "1_do@1"
        },
        {
          "command": "sight.terminal.doUpwardLines",
          "group": "1_do@2"
        },
        {
          "command": "sight.terminal.doDownwardLines",
          "group": "1_do@3"
        },
        {
          "command": "sight.terminal.doFile",
          "group": "1_do@4"
        },
        {
          "command": "sight.terminal.includeLineOrSelection",
          "group": "2_include@1"
        },
        {
          "command": "sight.terminal.includeFile",
          "group": "2_include@2"
        },
        {
          "command": "sight.terminal.cdWorkspace",
          "group": "3_cd@1",
          "when": "sight.cdMenuVisible"
        },
        {
          "command": "sight.terminal.cdFile",
          "group": "3_cd@2",
          "when": "sight.cdMenuVisible"
        }
      ]
    },
    "configurationDefaults": {
      "[stata]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.wordBasedSuggestions": "off",
        "editor.suggest.localityBonus": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run copy-vview-ado && bun run bundle && bun run copy-server",
    "bundle": "bunx esbuild src/extension.ts --bundle --platform=node --format=cjs --outfile=dist/extension.js --external:vscode --minify && node -e \"require('fs').writeFileSync('dist/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "bundle:webview": "bunx esbuild src/data-browser/webview/index.tsx --bundle --platform=browser --format=iife --outfile=dist/data-browser-webview/index.js --loader:.css=css --minify",
    "bundle:webview-test": "bunx esbuild src/data-browser/webview/test-harness/index.tsx --bundle --platform=browser --format=iife --outfile=dist-test/toolbar-wrap-harness/index.js --loader:.css=css",
    "copy-vview-ado": "mkdir -p stata && rm -f stata/*.ado && cp ../stata/*.ado stata/",
    "copy-server": "rm -rf server && mkdir -p server/command-database && bunx esbuild ../dist/server.js --bundle --platform=node --format=cjs --outfile=server/server.js --external:vscode --external:node:* --minify && cp -r ../dist/command-database/caches server/command-database/ && node -e \"require('fs').writeFileSync('server/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "compile": "bun run copy-vview-ado && bun run bundle && bun run bundle:webview",
    "watch": "tsc -watch -p ./",
    "pretest": "bun run compile && bun run lint",
    "lint": "eslint src",
    "test": "node ./test/runTest.js",
    "test:extension": "node ./test/runTest.js",
    "test:layout": "bun run bundle && bun run bundle:webview-test && node ./test/runTest.js --suite layout",
    "package": "vsce package --no-dependencies",
    "publish:vscode": "echo 'Internal-only: use the release workflow (vsce publish --packagePath client/*.vsix) for actual publishing.'",
    "publish:ovsx": "echo 'Internal-only: use the release workflow (ovsx publish client/*.vsix) for actual publishing.'",
    "publish:all": "npm run publish:vscode && npm run publish:ovsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jbearak/dta-parser": "^0.3.0",
    "@glideapps/glide-data-grid": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "mocha": "^11.7.6",
    "ovsx": "^0.8.3"
  }
}
