{
    "compilerOptions": {
        "module": "esnext",
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "jsx": "react-jsx",
        "sourceMap": true,
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "bundler",
        "types": ["vscode", "node"]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test",
        "dist"
    ]
}
