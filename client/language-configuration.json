{
    "comments": {
        "lineComment": "//",
        "blockComment": [
            "/*",
            "*/"
        ]
    },
    "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*",
    "brackets": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ]
    ],
    "autoClosingPairs": [
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "\"",
            "close": "\"",
            "notIn": ["string"]
        },
        {
            "open": "`",
            "close": "'",
            "notIn": []
        }
    ],
    "surroundingPairs": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "\"",
            "\""
        ]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(pr(?:o(?:g(?:r(?:a(?:m)?)?)?)?)?\\s+de(?:f(?:i(?:n(?:e)?)?)?)?|if|else|foreach|forvalues|while)\\b.*$|^\\s*\\{\\s*$",
        "decreaseIndentPattern": "^\\s*(end|else|\\})\\s*$"
    }
}