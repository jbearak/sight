# Development files
.vscode/**
src/**
tsconfig.json
bun.lock
**/*.ts
**/*.map

# Parent directory - exclude everything from parent
../**

# Test and build artifacts
**/*.test.ts
**/*.spec.ts
tests/**
# Test runners/harness (extension-smoke, toolbar-wrap layout suite); only
# used by `node ./test/runTest.js` during development, never at runtime.
test/**
# Real-layout test harness bundle (built by bun run bundle:webview-test)
dist-test/**

# Git
.git/**
.gitignore

# Documentation and misc
*.md
!README.md

# Dependencies are bundled by esbuild into dist/; exclude raw node_modules
node_modules/**

# Old VSIX files
*.vsix
