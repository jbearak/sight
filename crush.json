{
  "$schema": "https://charm.land/crush.json",
  "lsp": {
    "stata": {
      "command": "sight",
      "args": ["--stdio"],
      "extensions": [".do", ".ado", ".doh", ".mata"]
    },
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"]
    }
  }
}
